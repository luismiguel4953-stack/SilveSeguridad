<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:id="@+id/moduleTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/stageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="16sp" />
        <ProgressBar android:id="@+id/analysisProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:max="100" />
        <ProgressBar android:id="@+id/analysisSpinner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="20dp" />
        <EditText android:id="@+id/moduleInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:visibility="gone" />
        <Button android:id="@+id/moduleAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" />
        <TextView android:id="@+id/resultText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="18dp" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
