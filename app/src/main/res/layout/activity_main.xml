<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/ic_silve_shield" android:contentDescription="Escudo" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Silve Seguridad" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/welcomeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hola, Usuario" />
            </LinearLayout>
            <Button android:id="@+id/profileButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cuenta" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Centro de seguridad" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="18dp" android:text="Tu centro de seguridad está listo. Ejecuta un análisis para revisar el dispositivo." android:textSize="16sp" />
        <Button android:id="@+id/scanButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="🛡  Escaneo completo" />
        <Button android:id="@+id/appsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📱  Aplicaciones y vulnerabilidades" />
        <Button android:id="@+id/historyButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📊  Historial e informes" />
        <Button android:id="@+id/notificationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔔  Alertas de seguridad" />
        <Button android:id="@+id/linkButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🌐  Protección Web y URLs" />
        <Button android:id="@+id/passwordButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔐  Contraseñas" />
        <Button android:id="@+id/assistantButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🤖  Asistente de seguridad" />
        <Button android:id="@+id/emergencyButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🚨  Emergencia" />
        <Button android:id="@+id/settingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="⚙  Configuración avanzada" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="Silve Seguridad • Protección preventiva" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
